PORT=5000
# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/sda_youth
# Strong secret used to sign access tokens (generate with: openssl rand -base64 32)
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime (default 15 minutes)
ACCESS_TOKEN_TTL=15m
# Refresh token lifetime in days (default 7)
REFRESH_TOKEN_DAYS=7
# Optional: restrict CORS to specific origins (comma separated). Leave empty for dev.
CORS_ORIGIN=
# Seed admin credentials (used by npm run seed)
ADMIN_EMAIL=admin@kimarasdachurch.org
ADMIN_PASSWORD=ChangeMe!123
